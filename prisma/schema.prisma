generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Candidate {
  id              String          @id @default(cuid())
  ownerUserId     String?
  uploadedByUserId String?
  assignedRecruiterId String?
  name            String
  email           String?
  phone           String?
  recruiter       String?
  stage           String          @default("Identified")
  jobId           String?
  currentRole     String?
  skills          Json            @default("[]")
  experienceYears Float?
  profileSummary  String?
  keywords        Json            @default("[]")
  location        String?
  education       String?
  currentCompany  String?
  resumeUrl       String?
  resumeHash      String?
  parsedData      Json?
  parsingStatus   String          @default("PENDING")
  source          String?
  status          String          @default("ACTIVE")
  deletedAt       DateTime?
  duplicateOf     Json            @default("[]")
  mergedInto      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  activities      Activity[]

  @@index([status, createdAt])
  @@index([ownerUserId])
  @@index([uploadedByUserId])
  @@index([assignedRecruiterId])
  @@index([email])
  @@index([phone])
  @@index([jobId])
}

model Job {
  id                     String    @id @default(cuid())
  referenceNo            String?   @unique
  title                  String
  clientId               String?
  description            String?
  jdText                 String?
  requiredSkills         Json      @default("[]")
  preferredSkills        Json      @default("[]")
  minExperience          Float?
  maxExperience          Float?
  location               String?
  locations              Json      @default("[]")
  workMode               String?
  remoteScope            String?
  country                String?
  state                  String?
  city                   String?
  primaryTimeZone        String?
  supportedTimeZones     Json      @default("[]")
  workingHours           String?
  minTimeZoneOverlap     Int?
  jobType                String?
  openings               Int       @default(1)
  currency               String    @default("INR")
  minCtcLpa              Float?
  maxCtcLpa              Float?
  minBillingRate         Float?
  maxBillingRate         Float?
  billingRateType        String?
  compensationUndisclosed Boolean  @default(false)
  priority               String    @default("NORMAL")
  status                 String    @default("DRAFT")
  statusReason           String?
  ownerUserId            String?
  assignedRecruiterId    String?
  createdByUserId        String?
  updatedByUserId        String?
  openedAt               DateTime?
  targetClosureAt        DateTime?
  closedAt               DateTime?
  archivedAt             DateTime?
  legacyData             Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  client                 Client?   @relation(fields: [clientId], references: [id])

  @@index([status, createdAt])
  @@index([clientId])
  @@index([assignedRecruiterId])
  @@index([archivedAt])
}

model JobAudit {
  id         String   @id @default(cuid())
  jobId      String
  jobTitle   String
  actorId    String?
  actorName  String?
  action     String
  fromStatus String?
  toStatus   String?
  reason     String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([actorId, createdAt])
}

model CandidatePool {
  id              String                @id @default(cuid())
  name            String
  techStack       String
  sourceJobId     String?
  criteria        Json                  @default("{}")
  sourceInsight   Json?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  members         CandidatePoolMember[]

  @@index([techStack, createdAt])
  @@index([createdByUserId])
}

model CandidatePoolMember {
  id          String        @id @default(cuid())
  poolId      String
  candidateId String
  matchReason Json?
  addedAt     DateTime      @default(now())
  pool        CandidatePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([poolId, candidateId])
  @@index([candidateId])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]

  @@index([name])
}

model AtsUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         String   @default("EMPLOYEE")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UploadBatch {
  id          String   @id @default(cuid())
  fileName    String
  fileType    String
  status      String
  totalFiles  Int      @default(0)
  addedCount  Int      @default(0)
  failedCount Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
}

model AiInteraction {
  id             String   @id @default(cuid())
  conversationId String?
  prompt         String
  toolCalls      Json?
  response       Json?
  feedback       Json?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Activity {
  id          String    @id @default(cuid())
  candidateId String?
  actor       String?
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())
  candidate   Candidate? @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@index([createdAt])
}

model RuntimeState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
