{
  "name": "agodly-ats",
  "version": "1.0.0",
  "private": true,
  "description": "Agodly ATS — single Next.js app (frontend + API + SQLite/Prisma)",
  "scripts": {
    "predev": "npm run prisma:generate && npm run prisma:migrate:deploy",
    "dev": "next dev",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "prestart": "npm run prisma:migrate:deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:ensure": "node scripts/ensure-sqlite-db.mjs",
    "db:backup": "node scripts/backup-sqlite.mjs",
    "prisma:migrate:deploy": "npm run db:ensure && prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "deploy:check": "npm run prisma:generate && npm run typecheck && npm run prisma:validate && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "mammoth": "^1.8.0",
    "next": "^15.3.4",
    "openai": "^4.79.2",
    "pdf-parse": "^1.1.1",
    "prisma": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
