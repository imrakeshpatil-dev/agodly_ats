# Agodly ATS — production. Run as a long-lived Node server: `npm run build` then `npm run start`.
NODE_ENV=production
PORT=3000
# SQLite file store. IMPORTANT: this path MUST live on a persistent disk or a
# mounted volume so data survives restarts and redeploys. Do NOT use /tmp or an
# ephemeral serverless filesystem (readiness will report the app as degraded).
AGODLY_DATA_DIR=/var/lib/agodly-ats
DATABASE_URL=file:/var/lib/agodly-ats/agodly-ats.sqlite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADMIN_EMAIL=admin@agodly.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password
# REQUIRED in production (server refuses to start without it). >= 32 random chars.
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace_with_a_random_32plus_char_secret
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
