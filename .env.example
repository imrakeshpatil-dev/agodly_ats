# Agodly ATS — single Next.js app (frontend + API + SQLite). Local development.
NODE_ENV=development
PORT=3000
# SQLite file store (no external database needed).
DATABASE_URL=file:./data/agodly-ats.sqlite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADMIN_EMAIL=admin@agodly.com
ADMIN_PASSWORD=replace_with_a_strong_secret
# Secret used to sign session tokens. Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace_with_a_random_32plus_char_secret
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
