# Agodly ATS — single Next.js app (frontend + API + SQLite). Local development.
NODE_ENV=development
PORT=3000
# SQLite file store (no external database needed).
DATABASE_URL=file:./data/agodly-ats.sqlite
# Optional backup controls. Defaults to <database directory>/backups and 10 copies.
AGODLY_BACKUP_DIR=
AGODLY_BACKUP_RETENTION=10
# AI_PROVIDER accepts: ollama (default), openai, openrouter, disabled
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=2000
AI_RESUME_MAX_CHARS=18000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
# Paid providers are opt-in and server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADMIN_EMAIL=admin@agodly.com
ADMIN_PASSWORD=replace_with_a_strong_secret
# Secret used to sign session tokens. Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace_with_a_random_32plus_char_secret
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
